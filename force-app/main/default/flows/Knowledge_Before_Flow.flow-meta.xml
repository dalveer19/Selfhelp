    <decisions>
        <name>Capturing_Approval_Submitter</name>
        <label>Capturing Approval Submitter</label>
        <locationX>1378</locationX>
        <locationY>811</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Submitted_for_approval</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.PublishStatus</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Draft</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Approval_status__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>$Record__Prior.Approval_status__c</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Approval_status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Approval inprogress</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Submitter</targetReference>
            </connector>
            <label>Submitted for approval</label>
        </rules>
    </decisions>
